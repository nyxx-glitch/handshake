{
  "expo": {
    "name": "handshake",
    "slug": "handshake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Handshake.png",
    "scheme": "handshake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Handshake.png",
        "backgroundImage": "./assets/images/Handshake.png",
        "monochromeImage": "./assets/images/Handshake.png"
      },
      "package": "com.joigm.handshake",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Handshake.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Handshake.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c36fccf-51e7-4f8b-89d3-da132c647bc6"
      }
    }
  }
}
